# Copy to .env.local. All variables are optional: without them the claim
# workflow, dashboards and coverage calculator still run on the in-memory store.

# Chat assistant and 3-agent workflow (xAI Grok)
XAI_API_KEY=your_xai_api_key

# Text-to-speech for assistant replies
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional Google Cloud Storage for uploaded documents.
# Setting GCP_BUCKET_NAME or GOOGLE_CLOUD_PROJECT enables the GCS upload path.
GCP_BUCKET_NAME=claims-documents
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# Service-account JSON as a single-line string
GOOGLE_CLOUD_CREDENTIALS=
